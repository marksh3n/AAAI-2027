+    def get_vocab(self):
+        return {"a": 10, "b": 11}
+
+    def apply_chat_template(self, *args, **kwargs):
+        return "<think>"
+
+    def __call__(self, text, **kwargs):
+        if text == "ab":
+            return {"input_ids": [10, 11], "offset_mapping": [(0, 1), (1, 2)]}
+        return {"input_ids": [1, 3]}
