+def input_hash(prompt_ids, generated_prefix_ids):
+    return sha_obj([list(prompt_ids), list(generated_prefix_ids)])
+
+
+def register_key(seen, key):
+    if key in seen:
+        raise ValueError(f"duplicate prefix/round {key}")
+    seen.add(key)
+
