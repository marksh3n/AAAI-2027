+        expected = int(match.group(1))
+    if type(row["cut_token_idx"]) is not int or row["cut_token_idx"] != expected:
+        raise ValueError(f"checkpoint {checkpoint} disagrees with cut_token_idx={row['cut_token_idx']}")
+    return expected
